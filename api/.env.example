# Copy to .env (never commit .env).
PORT=3000
# Secret for signing JWT access tokens. Required in production (use a long random value).
JWT_SECRET=
# Leave unset to use the in-memory store. With `docker compose up -d db`:
# DATABASE_URL=postgres://roastline:roastline@localhost:5432/roastline
# Run the tests against PostgreSQL too:
# TEST_DATABASE_URL=postgres://roastline:roastline@localhost:5432/roastline_test
CORS_ORIGIN=
