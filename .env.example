# Base URL of the Roastline API. Leave unset in development to use the Vite proxy (/api -> localhost:3000).
# VITE_API_URL=https://your-api.onrender.com/api/v1

# Sent as X-API-Key on write requests. Must match API_KEY on the server.
# Note: anything prefixed VITE_ is visible in the browser bundle.
# VITE_API_KEY=demo-key
